# Canonical site URL (no trailing slash)
PUBLIC_SITE_URL=https://veronamedia.co.uk
# true in preview builds, false in production. Leave unset on Cloudflare Pages:
# branches other than `main` then count as previews automatically.
# PUBLIC_SHOW_PLACEHOLDERS=true
# Web3Forms access key (public by design, but kept out of the repo)
PUBLIC_WEB3FORMS_KEY=
# Cloudflare Web Analytics beacon token
PUBLIC_CF_BEACON_TOKEN=
# Existing ROI calculator (separate Pages project kvm-roi-calculator)
PUBLIC_ROI_CALCULATOR_URL=https://roi.kaiverona.co.uk
# Cal.com event for /book
PUBLIC_CAL_LINK=kai-verona-pkvqef/video-roadmap
