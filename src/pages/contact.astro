---
import BaseLayout from '../layouts/BaseLayout.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import PageHero from '../components/PageHero.astro';
import settings from '../content/settings.json';
import { getPage } from '../lib/content';

const { data: page } = await getPage('contact');
const crumbs = [{ label: settings.ui.home, href: '/' }, { label: page.h1 }];
// Link the email address inside the lead.
const lead = page.lead?.replace(settings.email, `[${settings.email}](mailto:${settings.email})`);
---
<BaseLayout title={page.seoTitle} description={page.description} breadcrumbs={crumbs}>
  <PageHero title={page.h1} lead={lead} breadcrumbs={crumbs} />
  <section class="section surface-stone section-tight">
    <div class="container narrow">
      <EnquiryForm labels={page.form!} />
    </div>
  </section>
</BaseLayout>
