---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import RoiEmbed from '../components/RoiEmbed.astro';
import settings from '../content/settings.json';
import { getPage } from '../lib/content';

const { data: page } = await getPage('roi-calculator');
const crumbs = [{ label: settings.ui.home, href: '/' }, { label: settings.nav.find((n) => n.href === '/roi-calculator')?.label ?? page.h1 }];
---
<BaseLayout title={page.seoTitle} description={page.description} breadcrumbs={crumbs} ctaRoi={false}>
  <PageHero title={page.h1} lead={page.lead} breadcrumbs={crumbs} />
  <section class="section surface-stone section-tight">
    <div class="container">
      <RoiEmbed title={page.iframeTitle!} fallbackText={page.fallbackText!} />
      <p class="disclaimer">{page.disclaimer}</p>
    </div>
  </section>
</BaseLayout>
