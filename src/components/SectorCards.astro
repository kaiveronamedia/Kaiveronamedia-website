---
interface Sector { name: string; pitch: string; href: string }
interface Props { sectors: Sector[] }
const { sectors } = Astro.props;
---
<ol class="who-index" role="list">
  {sectors.map((s, i) => (
    <li>
      {/* The link's name is its visible text (sector name first, then the pitch),
          which keeps WCAG 2.5.3 "label in name" intact. */}
      <a class="who-row" href={s.href}>
        <span class="who-no t-label" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <span class="who-name">{s.name}</span>
        <span class="who-pitch">{s.pitch}</span>
        <span class="who-arrow" aria-hidden="true">→</span>
      </a>
    </li>
  ))}
</ol>
