---
interface Sector { name: string; pitch: string; href: string }
interface Props { sectors: Sector[] }
const { sectors } = Astro.props;
const id = (name: string) => `sector-${name.toLowerCase().replace(/[^a-z]+/g, '-')}`;
---
<ol class="who-index" role="list">
  {sectors.map((s, i) => (
    <li>
      <a class="who-row" href={s.href} aria-labelledby={id(s.name)} aria-describedby={`${id(s.name)}-p`}>
        <span class="who-no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <span class="who-name" id={id(s.name)}>{s.name}</span>
        <span class="who-pitch" id={`${id(s.name)}-p`}>{s.pitch}</span>
        <span class="who-arrow" aria-hidden="true">→</span>
      </a>
    </li>
  ))}
</ol>
