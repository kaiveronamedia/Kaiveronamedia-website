---
import settings from '../content/settings.json';
import Text from './Text.astro';

export interface Crumb { label: string; href?: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;
---
<nav class="breadcrumbs" aria-label={settings.ui.breadcrumbLabel}>
  <ol>
    {items.map((item, i) => (
      <li>
        {item.href && i < items.length - 1 ? <a href={item.href}><Text value={item.label} /></a> : <span aria-current="page"><Text value={item.label} /></span>}
      </li>
    ))}
  </ol>
</nav>
