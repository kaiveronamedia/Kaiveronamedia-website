---
// Cal.com inline embed. The only page that loads it is /book (AGENTS.md §6).
import { CAL_LINK } from '../lib/env';

interface Props { fallbackText: string }
const { fallbackText } = Astro.props;
const bookingUrl = `https://cal.com/${CAL_LINK}`;
---
<div class="cal-frame">
  <div id="cal-inline" class="cal-inline" data-cal-link={CAL_LINK}></div>
</div>
<p class="cal-fallback"><a href={bookingUrl} target="_blank" rel="noopener">{fallbackText}</a></p>

<script is:inline>
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal; let ar = arguments;
      if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement('script')).src = A; cal.loaded = true; }
      if (ar[0] === L) {
        const api = function () { p(api, arguments); };
        const namespace = ar[1]; api.q = api.q || [];
        if (typeof namespace === 'string') { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ['initNamespace', namespace]); }
        else p(cal, ar);
        return;
      }
      p(cal, ar);
    };
  })(window, 'https://app.cal.com/embed/embed.js', 'init');
  (function () {
    var el = document.getElementById('cal-inline');
    if (!el) return;
    Cal('init', 'funnel-map', { origin: 'https://cal.com' });
    Cal.ns['funnel-map']('inline', {
      elementOrSelector: '#cal-inline',
      calLink: el.dataset.calLink,
      config: { layout: 'month_view' },
    });
    Cal.ns['funnel-map']('ui', {
      hideEventTypeDetails: false,
      layout: 'month_view',
      cssVarsPerTheme: { light: { 'cal-brand': '#3D9494' }, dark: { 'cal-brand': '#3D9494' } },
    });
  })();
</script>
