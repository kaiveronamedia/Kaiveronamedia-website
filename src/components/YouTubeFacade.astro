---
// Click-to-play YouTube. Nothing is requested from YouTube until the click
// (posters are local files), and playback uses youtube-nocookie.com.
// With no video ID the Placeholder renders instead (preview builds only).
import settings from '../content/settings.json';
import Placeholder from './Placeholder.astro';

interface Props {
  id?: string;
  title: string;
  poster?: string;
  aspect?: '9/16' | '16/9';
  hook?: string;
  job?: string;
  placeholder?: string;
  n?: number;
  class?: string;
}
const { id, title, poster, aspect = '9/16', hook, job, placeholder, n = 1, class: cls } = Astro.props;
const [w, h] = aspect === '9/16' ? [360, 640] : [640, 360];
---
{id ? (
  <figure class:list={['plate', cls]} data-n={n}>
    <div class="plate-annot" aria-hidden="true"><span class="datum"></span><span>{String(n).padStart(2, '0')} · {aspect.replace('/', ':')}</span></div>
    <div class="yt" data-yt={id} data-title={title} style={`aspect-ratio: ${w} / ${h}`}>
      <button type="button" class="yt-button plate-frame" aria-label={`${settings.ui.playVideo}: ${title}`}>
        {poster && <img src={poster} alt="" width={w} height={h} loading="lazy" decoding="async" />}
        <span class="yt-play" aria-hidden="true"><span class="disc"></span><span class="yt-play-label">Play</span></span>
      </button>
      <noscript><a class="yt-fallback" href={`https://www.youtube.com/watch?v=${id}`}>{settings.ui.watchOnYouTube}: {title}</a></noscript>
    </div>
    {(hook || job) && (
      <figcaption class="lower-third">
        {hook && <span class="lt-title">{hook}</span>}
        {job && <span class="lt-meta">{job}</span>}
      </figcaption>
    )}
  </figure>
) : (
  placeholder && <div class:list={['plate', cls]}><Placeholder description={placeholder} aspect={`${w}/${h}`} /></div>
)}

<script>
  document.querySelectorAll<HTMLElement>('.yt[data-yt]').forEach((box) => {
    box.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(box.dataset.yt!)}?autoplay=1&rel=0&playsinline=1`;
      iframe.title = box.dataset.title ?? '';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.className = 'yt-iframe';
      box.replaceChildren(iframe);
      iframe.focus();
    }, { once: true });
  });
</script>
