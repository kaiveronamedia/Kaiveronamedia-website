---
// Section label row (hairline, number, eyebrow) and the H2.
// `index`/`total` are computed by the page from the sections it actually renders.
interface Props {
  eyebrow?: string;
  headingId: string;
  index?: number;
  total?: number;
  title?: string;
}
const { eyebrow, headingId, index, total, title } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---
<div class="section-head">
  <p class="eyebrow">
    {index !== undefined && <span aria-hidden="true">{pad(index)}{eyebrow ? ' · ' : ''}</span>}{eyebrow}
  </p>
  {total !== undefined && <p class="section-total" aria-hidden="true">/ {pad(total)}</p>}
</div>
{title && <h2 id={headingId} class="section-title">{title}</h2>}
