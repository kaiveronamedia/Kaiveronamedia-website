---
import Text from './Text.astro';
import { visibleItems } from '../lib/placeholders';

interface Props { items: { question: string; answer: string }[] }
// Items still holding a placeholder are dropped in production.
const items = visibleItems(Astro.props.items);
---
{items.length > 0 && (
  <div class="faq">
    {items.map((f) => (
      <details class="faq-row">
        <summary><span class="faq-q"><Text value={f.question} /></span><span class="faq-icon" aria-hidden="true"></span></summary>
        <div class="faq-a"><p><Text value={f.answer} /></p></div>
      </details>
    ))}
  </div>
)}
